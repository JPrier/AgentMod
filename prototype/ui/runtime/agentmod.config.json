{
  "runtime": {
    "max_causal_depth": 2048,
    "spill_threshold_bytes": 16384,
    "max_attempts": 3,
    "streaming": {
      "flush_ms": 33,
      "flush_bytes": 512,
      "client_queue_bytes": 262144,
      "max_stream_bytes": 4194304,
      "compact_after_segments": 64
    }
  },
  "plugins": {
    "approval-gate": {
      "command": [
        "node",
        "plugins/approval-gate/main.js"
      ],
      "module": "plugins/approval-gate/main.js",
      "config": {
        "require": [
          "delegate"
        ]
      }
    },
    "ask-user": {
      "command": [
        "node",
        "plugins/ask-user/main.js"
      ],
      "module": "plugins/ask-user/main.js",
      "config": null
    },
    "browser-control": {
      "command": [
        "node",
        "plugins/browser-control/main.js"
      ],
      "config": null,
      "timeout_ms": 120000
    },
    "budget": {
      "command": [
        "node",
        "plugins/budget/main.js"
      ],
      "module": "plugins/budget/main.js",
      "config": {
        "max_model_requests": 40,
        "max_wall_seconds": 1800
      }
    },
    "chat-context": {
      "command": [
        "node",
        "plugins/chat-context/main.js"
      ],
      "module": "plugins/chat-context/main.js",
      "config": null
    },
    "heartbeat": {
      "command": [
        "node",
        "plugins/heartbeat/main.js"
      ],
      "module": "plugins/heartbeat/main.js",
      "config": {
        "agent_definition": "chat",
        "agent_every": 0,
        "every_seconds": 0
      }
    },
    "linux-sandbox": {
      "command": [],
      "module": "plugins/linux-sandbox/main.js",
      "config": {
        "workspace": "default"
      },
      "timeout_ms": 1200000
    },
    "local-workspace": {
      "command": [
        "node",
        "plugins/local-workspace/main.js"
      ],
      "config": {
        "root": ".agentmod/workspace"
      },
      "timeout_ms": 1900000
    },
    "mcp-bridge": {
      "command": [
        "node",
        "plugins/mcp-bridge/main.js"
      ],
      "config": {
        "servers": {}
      },
      "timeout_ms": 600000
    },
    "memory": {
      "command": [
        "node",
        "plugins/memory/main.js"
      ],
      "module": "plugins/memory/main.js",
      "config": null
    },
    "minimal-shell": {
      "command": [
        "node",
        "plugins/minimal-shell/main.js"
      ],
      "config": {
        "root": ".agentmod/workspace"
      },
      "timeout_ms": 1900000
    },
    "openai-model": {
      "command": [
        "node",
        "plugins/openai-model/main.js"
      ],
      "module": "plugins/openai-model/main.js",
      "config": {
        "api_key_env": "OPENAI_API_KEY",
        "base_url": "https://api.openai.com/v1",
        "model": "gpt-4o-mini"
      }
    },
    "openrouter-minimal": {
      "command": [
        "node",
        "plugins/openrouter-model/main.js"
      ],
      "config": {
        "api_key_env": "OPENROUTER_API_KEY",
        "max_tokens": 4096,
        "minimal": true,
        "model": "openai/gpt-4o-mini"
      }
    },
    "openrouter-model": {
      "command": [
        "node",
        "plugins/openrouter-model/main.js"
      ],
      "module": "plugins/openrouter-model/main.js",
      "config": {
        "api_key_env": "OPENROUTER_API_KEY",
        "max_tokens": 4096,
        "model": "openai/gpt-4o-mini"
      }
    },
    "plan": {
      "command": [
        "node",
        "plugins/plan/main.js"
      ],
      "module": "plugins/plan/main.js",
      "config": null
    },
    "policy": {
      "command": [
        "node",
        "plugins/policy/main.js"
      ],
      "module": "plugins/policy/main.js",
      "config": {
        "approvers": [
          "web-ui"
        ],
        "mode": "default"
      }
    },
    "py-wordcount": {
      "command": [
        "python3",
        "plugins/py-wordcount/main.py"
      ],
      "config": null
    },
    "redactor": {
      "command": [
        "node",
        "plugins/redactor/main.js"
      ],
      "module": "plugins/redactor/main.js",
      "config": null
    },
    "subagent": {
      "command": [
        "node",
        "plugins/subagent/main.js"
      ],
      "module": "plugins/subagent/main.js",
      "config": {
        "definition": "worker",
        "max_children": 8,
        "max_steps": 30
      }
    },
    "subagent-reporter": {
      "command": [
        "node",
        "plugins/subagent-reporter/main.js"
      ],
      "module": "plugins/subagent-reporter/main.js",
      "config": null
    },
    "titler": {
      "command": [
        "node",
        "plugins/titler/main.js"
      ],
      "module": "plugins/titler/main.js",
      "config": null
    },
    "tool-calc": {
      "command": [
        "node",
        "plugins/tool-calc/main.js"
      ],
      "module": "plugins/tool-calc/main.js",
      "config": null
    },
    "tool-clock": {
      "command": [
        "node",
        "plugins/tool-clock/main.js"
      ],
      "module": "plugins/tool-clock/main.js",
      "config": null
    },
    "tool-discovery": {
      "command": [
        "node",
        "plugins/tool-discovery/main.js"
      ],
      "module": "plugins/tool-discovery/main.js",
      "config": null
    },
    "web-fetch": {
      "command": [
        "node",
        "plugins/web-fetch/main.js"
      ],
      "module": "plugins/web-fetch/main.js",
      "config": {
        "max_bytes": 40000,
        "timeout_seconds": 20
      }
    },
    "web-ui": {
      "command": [
        "node",
        "plugins/web-ui/main.js"
      ],
      "config": {
        "host": "127.0.0.1",
        "port": 7700,
        "static_dir": "ui"
      }
    }
  },
  "definitions": {
    "chat": {
      "description": "Interactive chat agent with tools, memory, approval, and sub-agents",
      "subscribers": [
        {
          "plugin": "web-ui"
        },
        {
          "plugin": "redactor"
        },
        {
          "plugin": "approval-gate"
        },
        {
          "plugin": "chat-context"
        },
        {
          "plugin": "openrouter-model"
        },
        {
          "plugin": "titler"
        },
        {
          "plugin": "memory"
        },
        {
          "plugin": "tool-clock"
        },
        {
          "plugin": "tool-calc"
        },
        {
          "plugin": "py-wordcount"
        },
        {
          "plugin": "subagent"
        }
      ]
    },
    "coder": {
      "description": "Coding agent: plans, searches, edits with patches, runs builds/tests/servers, delegates, and can be rewound",
      "subscribers": [
        {
          "plugin": "web-ui"
        },
        {
          "plugin": "redactor"
        },
        {
          "plugin": "ask-user"
        },
        {
          "plugin": "policy"
        },
        {
          "plugin": "chat-context"
        },
        {
          "plugin": "openrouter-model"
        },
        {
          "plugin": "titler"
        },
        {
          "plugin": "plan"
        },
        {
          "plugin": "tool-discovery"
        },
        {
          "plugin": "linux-sandbox"
        },
        {
          "plugin": "local-workspace"
        },
        {
          "plugin": "subagent"
        },
        {
          "plugin": "memory"
        },
        {
          "plugin": "web-fetch"
        },
        {
          "plugin": "mcp-bridge"
        },
        {
          "plugin": "browser-control"
        }
      ]
    },
    "heartbeat": {
      "description": "Journal session for the heartbeat trigger (one record per fire)",
      "subscribers": [
        {
          "plugin": "web-ui"
        },
        {
          "plugin": "heartbeat"
        }
      ]
    },
    "minimal": {
      "description": "Baseline loop for benchmarks: a provider, the chat loop, and one shell tool",
      "subscribers": [
        {
          "plugin": "web-ui"
        },
        {
          "plugin": "chat-context"
        },
        {
          "plugin": "openrouter-minimal"
        },
        {
          "plugin": "minimal-shell"
        }
      ]
    },
    "worker": {
      "description": "Child agent started by `delegate`: scoped tools, budget, isolated workspace; reports back to its parent",
      "subscribers": [
        {
          "plugin": "web-ui"
        },
        {
          "plugin": "policy"
        },
        {
          "plugin": "budget"
        },
        {
          "plugin": "chat-context"
        },
        {
          "plugin": "openrouter-model"
        },
        {
          "plugin": "plan"
        },
        {
          "plugin": "tool-discovery"
        },
        {
          "plugin": "linux-sandbox"
        },
        {
          "plugin": "local-workspace"
        },
        {
          "plugin": "tool-clock"
        },
        {
          "plugin": "tool-calc"
        },
        {
          "plugin": "subagent-reporter"
        }
      ]
    }
  }
}
