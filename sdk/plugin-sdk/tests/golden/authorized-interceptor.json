{
  "schema_version": 1,
  "identity": {
    "id": "agentmod.audit",
    "version": "1.2.3",
    "runtime_api": "^1.2"
  },
  "category": "interceptor",
  "scope": "session",
  "classification": "blocking",
  "entrypoint": {
    "kind": "rust_builtin",
    "symbol": "audit_interceptor"
  },
  "trust": "first_party",
  "isolation": "trusted_in_process",
  "required_capabilities": [
    "runtime.events"
  ],
  "provided_capabilities": [
    "plugin.audit"
  ],
  "subscribed_events": [
    "tool.call.proposed"
  ],
  "authorities": {
    "read": [
      "session_state"
    ],
    "proposed_write": [
      "canonical_state"
    ]
  },
  "permissions": {
    "tools": [
      "filesystem.read"
    ],
    "network": []
  },
  "ordering": {
    "stage": 20,
    "priority": 100,
    "before": [],
    "after": []
  },
  "configuration": {
    "schema_id": "agentmod.audit.config",
    "schema_version": 1,
    "required": false,
    "source": {
      "kind": "inline_json",
      "document": "{\"type\":\"object\",\"additionalProperties\":false}"
    }
  },
  "failure_policy": {
    "kind": "reject"
  },
  "timeout_ms": 5000,
  "state_migration_version": 1,
  "node_executors": [],
  "memory": null,
  "compaction": null,
  "context_transforms": [],
  "observer_delivery": {
    "mode": "best_effort"
  }
}
