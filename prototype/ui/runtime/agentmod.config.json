{
  "runtime": {
    "spill_threshold_bytes": 16384,
    "max_attempts": 3,
    "streaming": {
      "flush_ms": 33,
      "flush_bytes": 512,
      "client_queue_bytes": 262144,
      "max_stream_bytes": 4194304,
      "compact_after_segments": 64
    }
  },
  "plugins": {
    "approval-gate": {
      "command": [
        "node",
        "plugins/approval-gate/main.js"
      ],
      "module": "plugins/approval-gate/main.js",
      "config": {
        "require": [
          "delegate"
        ]
      }
    },
    "ask-user": {
      "command": [
        "node",
        "plugins/ask-user/main.js"
      ],
      "module": "plugins/ask-user/main.js",
      "config": null
    },
    "browser-control": {
      "command": [
        "node",
        "plugins/browser-control/main.js"
      ],
      "config": null,
      "timeout_ms": 120000
    },
    "budget": {
      "command": [
        "node",
        "plugins/budget/main.js"
      ],
      "module": "plugins/budget/main.js",
      "config": {
        "max_model_requests": 40,
        "max_wall_seconds": 1800
      }
    },
    "chat-context": {
      "command": [
        "node",
        "plugins/chat-context/main.js"
      ],
      "module": "plugins/chat-context/main.js",
      "config": null
    },
    "heartbeat": {
      "command": [
        "node",
        "plugins/heartbeat/main.js"
      ],
      "module": "plugins/heartbeat/main.js",
      "config": {
        "agent_definition": "chat",
        "agent_every": 0,
        "every_seconds": 0
      }
    },
    "linux-sandbox": {
      "command": [],
      "module": "plugins/linux-sandbox/main.js",
      "config": {
        "workspace": "default"
      },
      "timeout_ms": 1200000
    },
    "local-workspace": {
      "command": [
        "node",
        "plugins/local-workspace/main.js"
      ],
      "config": {
        "root": ".agentmod/workspace"
      },
      "timeout_ms": 1900000
    },
    "loop-limit": {
      "command": [
        "node",
        "plugins/budget/main.js"
      ],
      "module": "plugins/budget/main.js",
      "config": {
        "max_turn_model_requests": 500
      }
    },
    "mcp-bridge": {
      "command": [
        "node",
        "plugins/mcp-bridge/main.js"
      ],
      "config": {
        "servers": {}
      },
      "timeout_ms": 600000
    },
    "memory": {
      "command": [
        "node",
        "plugins/memory/main.js"
      ],
      "module": "plugins/memory/main.js",
      "config": null
    },
    "minimal-shell": {
      "command": [
        "node",
        "plugins/minimal-shell/main.js"
      ],
      "config": {
        "root": ".agentmod/workspace"
      },
      "timeout_ms": 1900000
    },
    "openai-model": {
      "command": [
        "node",
        "plugins/openai-model/main.js"
      ],
      "module": "plugins/openai-model/main.js",
      "config": {
        "api_key_env": "OPENAI_API_KEY",
        "base_url": "https://api.openai.com/v1",
        "model": "gpt-4o-mini"
      }
    },
    "openrouter-minimal": {
      "command": [
        "node",
        "plugins/openrouter-model/main.js"
      ],
      "config": {
        "api_key_env": "OPENROUTER_API_KEY",
        "max_tokens": 4096,
        "minimal": true,
        "model": "openai/gpt-4o-mini"
      }
    },
    "openrouter-model": {
      "command": [
        "node",
        "plugins/openrouter-model/main.js"
      ],
      "module": "plugins/openrouter-model/main.js",
      "config": {
        "api_key_env": "OPENROUTER_API_KEY",
        "max_tokens": 4096,
        "model": "openai/gpt-4o-mini"
      }
    },
    "plan": {
      "command": [
        "node",
        "plugins/plan/main.js"
      ],
      "module": "plugins/plan/main.js",
      "config": null
    },
    "policy": {
      "command": [
        "node",
        "plugins/policy/main.js"
      ],
      "module": "plugins/policy/main.js",
      "config": {
        "approvers": [
          "web-ui"
        ],
        "mode": "default"
      }
    },
    "py-wordcount": {
      "command": [
        "python3",
        "plugins/py-wordcount/main.py"
      ],
      "config": null
    },
    "redactor": {
      "command": [
        "node",
        "plugins/redactor/main.js"
      ],
      "module": "plugins/redactor/main.js",
      "config": null
    },
    "subagent": {
      "command": [
        "node",
        "plugins/subagent/main.js"
      ],
      "module": "plugins/subagent/main.js",
      "config": {
        "definition": "worker",
        "max_children": 8,
        "max_steps": 30
      }
    },
    "subagent-reporter": {
      "command": [
        "node",
        "plugins/subagent-reporter/main.js"
      ],
      "module": "plugins/subagent-reporter/main.js",
      "config": null
    },
    "titler": {
      "command": [
        "node",
        "plugins/titler/main.js"
      ],
      "module": "plugins/titler/main.js",
      "config": null
    },
    "tool-calc": {
      "command": [
        "node",
        "plugins/tool-calc/main.js"
      ],
      "module": "plugins/tool-calc/main.js",
      "config": null
    },
    "tool-clock": {
      "command": [
        "node",
        "plugins/tool-clock/main.js"
      ],
      "module": "plugins/tool-clock/main.js",
      "config": null
    },
    "tool-discovery": {
      "command": [
        "node",
        "plugins/tool-discovery/main.js"
      ],
      "module": "plugins/tool-discovery/main.js",
      "config": null
    },
    "web-fetch": {
      "command": [
        "node",
        "plugins/web-fetch/main.js"
      ],
      "module": "plugins/web-fetch/main.js",
      "config": {
        "max_bytes": 40000,
        "timeout_seconds": 20
      }
    },
    "web-ui": {
      "command": [
        "node",
        "plugins/web-ui/main.js"
      ],
      "config": {
        "host": "127.0.0.1",
        "port": 7700,
        "static_dir": "ui"
      }
    }
  },
  "definitions": {
    "chat": {
      "description": "Interactive chat agent with tools, memory, approval, and sub-agents",
      "runtime": "0.1",
      "phases": [
        "offer",
        "intake",
        "guard",
        "loop"
      ],
      "plugins": {
        "approval-gate": {
          "phase": "guard"
        },
        "chat-context": {
          "phase": "loop"
        },
        "loop-limit": {
          "phase": "guard"
        },
        "memory": {
          "phase": "offer"
        },
        "openrouter-model": {},
        "py-wordcount": {
          "phase": "offer"
        },
        "redactor": {
          "phase": "intake"
        },
        "subagent": {
          "phase": "offer"
        },
        "titler": {},
        "tool-calc": {
          "phase": "offer"
        },
        "tool-clock": {
          "phase": "offer"
        },
        "web-ui": {}
      },
      "order": {
        "config-applied": {
          "offer": [
            "memory",
            "tool-clock",
            "tool-calc",
            "py-wordcount",
            "subagent"
          ]
        },
        "session-started": {
          "offer": [
            "memory",
            "tool-clock",
            "tool-calc",
            "py-wordcount",
            "subagent"
          ]
        }
      },
      "inbound": {
        "subagent-result": {
          "call_id": {
            "shape": "string"
          },
          "evidence": {
            "shape": "object"
          },
          "text": {
            "shape": "string"
          },
          "worker": {
            "shape": "string"
          }
        }
      }
    },
    "coder": {
      "description": "Coding agent: plans, searches, edits with patches, runs builds/tests/servers, delegates, and can be rewound",
      "runtime": "0.1",
      "phases": [
        "offer",
        "intake",
        "guard",
        "loop"
      ],
      "plugins": {
        "ask-user": {
          "phase": "offer",
          "phases": {
            "user-message": "intake"
          }
        },
        "browser-control": {
          "phase": "offer"
        },
        "chat-context": {
          "phase": "loop"
        },
        "linux-sandbox": {
          "phase": "offer"
        },
        "local-workspace": {
          "phase": "offer"
        },
        "loop-limit": {
          "phase": "guard"
        },
        "mcp-bridge": {
          "phase": "offer"
        },
        "memory": {
          "phase": "offer"
        },
        "openrouter-model": {},
        "plan": {
          "phase": "offer"
        },
        "policy": {
          "phase": "guard"
        },
        "redactor": {
          "phase": "intake"
        },
        "subagent": {
          "phase": "offer"
        },
        "titler": {},
        "tool-discovery": {
          "phase": "offer",
          "phases": {
            "user-message": "intake"
          }
        },
        "web-fetch": {
          "phase": "offer"
        },
        "web-ui": {}
      },
      "order": {
        "config-applied": {
          "offer": [
            "ask-user",
            "plan",
            "tool-discovery",
            "linux-sandbox",
            "local-workspace",
            "subagent",
            "memory",
            "web-fetch",
            "mcp-bridge",
            "browser-control"
          ]
        },
        "model-request": {
          "guard": [
            "loop-limit",
            "policy"
          ]
        },
        "session-started": {
          "offer": [
            "ask-user",
            "plan",
            "tool-discovery",
            "linux-sandbox",
            "local-workspace",
            "subagent",
            "memory",
            "web-fetch",
            "mcp-bridge",
            "browser-control"
          ]
        },
        "user-message": {
          "intake": [
            "redactor",
            "ask-user",
            "tool-discovery"
          ]
        }
      },
      "inbound": {
        "subagent-result": {
          "call_id": {
            "shape": "string"
          },
          "evidence": {
            "shape": "object"
          },
          "text": {
            "shape": "string"
          },
          "worker": {
            "shape": "string"
          }
        }
      }
    },
    "heartbeat": {
      "description": "Journal session for the heartbeat trigger (one record per fire)",
      "runtime": "0.1",
      "plugins": {
        "heartbeat": {},
        "web-ui": {}
      }
    },
    "minimal": {
      "description": "Baseline loop for benchmarks: a provider, the chat loop, and one shell tool",
      "runtime": "0.1",
      "phases": [
        "offer",
        "loop"
      ],
      "plugins": {
        "chat-context": {
          "phase": "loop"
        },
        "minimal-shell": {
          "phase": "offer"
        },
        "openrouter-minimal": {},
        "web-ui": {}
      }
    },
    "worker": {
      "description": "Child agent started by `delegate`: scoped tools, budget, isolated workspace; reports back to its parent",
      "runtime": "0.1",
      "phases": [
        "offer",
        "intake",
        "guard",
        "loop"
      ],
      "plugins": {
        "budget": {
          "phase": "guard"
        },
        "chat-context": {
          "phase": "loop"
        },
        "linux-sandbox": {
          "phase": "offer"
        },
        "local-workspace": {
          "phase": "offer"
        },
        "openrouter-model": {},
        "plan": {
          "phase": "offer"
        },
        "policy": {
          "phase": "guard"
        },
        "subagent-reporter": {},
        "tool-calc": {
          "phase": "offer"
        },
        "tool-clock": {
          "phase": "offer"
        },
        "tool-discovery": {
          "phase": "offer",
          "phases": {
            "user-message": "intake"
          }
        },
        "web-ui": {}
      },
      "order": {
        "config-applied": {
          "offer": [
            "plan",
            "tool-discovery",
            "linux-sandbox",
            "local-workspace",
            "tool-clock",
            "tool-calc"
          ]
        },
        "model-request": {
          "guard": [
            "budget",
            "policy"
          ]
        },
        "session-started": {
          "offer": [
            "plan",
            "tool-discovery",
            "linux-sandbox",
            "local-workspace",
            "tool-clock",
            "tool-calc"
          ]
        }
      }
    }
  },
